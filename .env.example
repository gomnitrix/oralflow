# AI providers
OPENAI_API_KEY=sk-your-key
GEMINI_API_KEY=gem-your-key
# REALTIME_PROVIDER is deprecated in favor of UI-based configuration
# REALTIME_PROVIDER=openai

# Third-party OpenAI-compatible providers
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local persistence
LOCAL_STORAGE_PATH=./data/storage

# Azure Speech (Pronunciation Assessment)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: override endpoint instead of region (e.g., https://<region>.stt.speech.microsoft.com/)
AZURE_SPEECH_ENDPOINT=
